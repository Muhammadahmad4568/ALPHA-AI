# =====================================================================
#  Alpha AI v4.  Copy this file to ".env" (next to main.py) and edit.
#  Never share or commit .env.  Old variable names still work.
# =====================================================================

# ---- AI brain -------------------------------------------------------
# FREE key: https://aistudio.google.com/apikey  (sign in -> Create API key)
GEMINI_API_KEY=paste_your_gemini_key_here
GEMINI_MODEL=                   # optional pin, e.g. gemini-3.5-flash  (gemini-1.5-flash was retired by Google)
GEMINI_THINKING_LEVEL=          # optional, e.g. low
ANTHROPIC_API_KEY=              # optional paid alternative
ALPHA_MODEL=claude-haiku-4-5-20251001
ALPHA_PROVIDER=auto             # auto | gemini | claude
ALPHA_STREAMING=1               # speak the first sentence while the rest is still being written
ALPHA_FAST_PATH=1               # simple commands ("open task manager") skip the LLM

# ---- Voice lock (only YOUR voice may command Alpha) ----------------------
ALPHA_VOICE_LOCK=strict         # strict | warn (log only) | off.  Enroll with: python main.py enroll
ALPHA_VOICE_BACKEND=mfcc        # mfcc (no extra install) | speechbrain (accurate; pip install torch speechbrain)
ALPHA_VOICE_STRICTNESS=1.0      # >1 more lenient, <1 stricter.  If YOU get rejected, try 1.3
ALPHA_VOICE_MIN_SECONDS=0.5     # shorter phrases cannot be verified and are refused

# ---- Wake word / noise ----------------------------------------------------
ALPHA_FOLLOWUP_SECONDS=0        # 0 = strict: every command starts with "Alpha"
ALPHA_GATE_DB=-55               # noise gate on RAW input (dBFS); also adjustable in the dashboard
ALPHA_SPEECH_CHECK=1            # drop thumps / hiss / keyboard clatter
ALPHA_AUTO_GATE=1               # repeated false triggers raise the gate by 3 dB
ALPHA_FALSE_TRIGGER_LIMIT=6
ALPHA_FALSE_TRIGGER_WINDOW=90

# ---- Speech recognition & microphone ----------------------------------------
ALPHA_WHISPER_MODEL=base        # tiny | base | small (best Urdu)
ALPHA_STT_LANG=auto             # auto | en | ur
ALPHA_STT_LANGS=en,ur
ALPHA_STT_IDLE_UNLOAD=600       # seconds idle before Whisper is unloaded (0 = never)
ALPHA_MIC=                      # device index or part of its name (python main.py list-mics)
ALPHA_MIC_GAIN=auto
ALPHA_MIN_RMS=0.006
ALPHA_VAD_RATIO=2.5
ALPHA_SILENCE=0.6
ALPHA_DENOISE=0.5

# ---- Dashboard ---------------------------------------------------------------
ALPHA_WINDOW=app                # app = frameless Edge/Chrome window | browser = normal tab
ALPHA_WEB_HOST=127.0.0.1        # keep 127.0.0.1 unless you really need LAN access
ALPHA_WEB_PORT=8765
ALPHA_OPEN_BROWSER=1
# SERVER_TOKEN=                 # optional fixed token (default: random each start). ALPHA_WEB_TOKEN is an alias.
# ALPHA_WEB_ALLOWED_HOSTS=      # extra Host names (when exposed to a LAN)
# ALPHA_DATA_DIR=               # where memory, voice profile and logs live (default ./data)

# ---- WhatsApp (Playwright + WhatsApp Web) ---------------------------------------
WHATSAPP_ENABLED=1
WHATSAPP_DEFAULT_COUNTRY=       # e.g. 92 so "0300 1234567" works; or always use +92...
WHATSAPP_BROWSER=msedge         # msedge | chrome (installed on Windows already); falls back to bundled chromium
WHATSAPP_HEADLESS=0             # keep 0 for the first QR scan; 1 afterwards if you prefer no window
WHATSAPP_MAX_PER_HOUR=10        # safety limits to protect your account
WHATSAPP_MIN_GAP=8
WHATSAPP_IDLE_CLOSE=600         # close the WhatsApp browser after N idle seconds (login is kept)

# ---- Web reader ------------------------------------------------------------------
# TAVILY_API_KEY=               # free key at https://tavily.com : reliable web search (else best-effort DuckDuckGo)
WEB_MAX_CHARS=6000
WEB_TIMEOUT=15
WEB_RENDER=auto                 # auto = use a headless browser only when a page needs JavaScript | always | never
WEB_ALLOW_PRIVATE=0             # keep 0: never fetch localhost / LAN / cloud-metadata addresses

# ---- n8n automation (optional) -----------------------------------------------------
# N8N_WORKFLOWS={"email_draft":{"url":"http://localhost:5678/webhook/email-draft","description":"drafts an email"}}
# N8N_AUTH_HEADER=X-Alpha-Secret
# N8N_AUTH_VALUE=
N8N_TIMEOUT=30
N8N_RETRIES=2
N8N_CONFIRM=1                   # ask yes/no before running any workflow

ALPHA_LOG_TITLES=1              # 0 = screen time records app names only
